{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "navigationRequestStrategy": "freshness",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "pokeapi",
      "urls": [
        "https://pokeapi.co/api/v2/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 3000,
        "maxAge": "30d"
      }
    },
    {
      "name": "cries",
      "urls": [
        "https://raw.githubusercontent.com/PokeAPI/cries/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 300,
        "maxAge": "30d",
        "cacheOpaqueResponses": false
      }
    },
    {
      "name": "artwork",
      "urls": [
        "https://raw.githubusercontent.com/PokeAPI/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 3000,
        "maxAge": "30d",
        "cacheOpaqueResponses": true
      }
    },
    {
      "name": "fonts",
      "urls": [
        "https://fonts.googleapis.com/**",
        "https://fonts.gstatic.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 20,
        "maxAge": "365d",
        "cacheOpaqueResponses": true
      }
    },
    {
      "name": "pages",
      "urls": [
        "/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxSize": 300,
        "maxAge": "30d"
      }
    }
  ]
}
